PORT=3001
DATABASE_URL=postgresql://user:password@your-cluster.region.cockroachlabs.cloud:26257/statnexus?sslmode=verify-full
JWT_SECRET=replace-with-a-long-random-secret

# Frontend URL(s) — comma-separated for Netlify + localhost
CLIENT_ORIGIN=http://localhost:5173,https://statnexus.netlify.app/
APP_URL=https://statnexus.netlify.app

# Email (Resend SMTP example — or Gmail, SendGrid, etc.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key
EMAIL_FROM=StatNexus <onboarding@yourdomain.com>

# Set to true to block login until email is verified
REQUIRE_EMAIL_VERIFICATION=false
